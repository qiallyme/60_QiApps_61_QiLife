  Browser[Browser]
  Auth[AuthenticationBoundary]
  Router[AppRouter]
  Registry[ModuleRegistry]
  Frame[ModuleRouteFrame]

  Today[Today]
  Actions[Actions]
  Projects[Projects]
  People[People]
  Journal[Journal]

  Selector[RelationSelector]
  Resolver[RelationshipResolver]
  Store[QiLifeStore]
  API[QiApiClient]
